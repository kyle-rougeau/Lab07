architecture behv of task01 is
Signal state : UNSIGNED (2 downto 0) := "000";
begin
process(clk)
begin
if rising_edge(clk) then
 case state is
 when "000" => --base | c=0, s=1
  if x = '1' then
   s <= '0';
   v <= '0';
   state <= state + 2;
  else
   s <= '1';
   v <= '0';
   state <= state + 1;
  end if;
 when "001" => --no_carry0 | c=0, s=1
  if x = '1' then
   s <= '0';
   state <= state + 3;
  else
   s <= '1';
   state <= state + 2;
  end if;
 when "010" => --carry0 | c=1, s=1
  if x = '1' then
   s <= '1';
   state <= state + 2;
  else
   s <= '0';
   state <= state + 2;
  end if;
 when "011" => --no_carry1 | c=0, s=0
  if x = '1' then
   s <= '1';
   state <= state + 2;
  else
   s <= '0';
   state <= state + 2;
  end if;
 when "100" => --carry1 | c=1, s=0
  if x = '1' then
   s <= '0';
   state <= state + 2;
  else
   s <= '1';
   state <= state + 1;
  end if;
 when "101" => --no_carry2 | c=0, s=0
  if x = '1' then
   s <= '1';
   state <= "000";
  else
   s <= '0';
   state <= "000";
  end if;
 when "110" => --carry2 | c=1, s=0
  if x = '1' then
   s <= '0';
   v <= '1';
   state <= "000";
  else
   s <= '1';
   state <= "000";
  end if;
 when others =>
 end case;

end if;
end process;
end behv;

architecture dflo of task01 is
--Signal state : UNSIGNED (2 downto 0);
Signal temp, state : UNSIGNED (2 downto 0) := "000";
Signal start : STD_LOGIC := '0';
begin

temp(2) <= ( not(state(2)) and not(state(1)) and state(0) and x) or (not(state(2)) and state(1) and not(state(0)) and not(x) ) or ( not(state(2)) and state(1) and not(state(0)) and x ) or ( not(state(2)) and state(1) and state(0) and not(x) ) or ( not(state(2)) and state(1) and state(0) and x ) or ( state(2) and not(state(1)) and not(state(0)) and not(x) ) or ( state(2) and not(state(1)) and not(state(0)) and x);
temp(1) <= ( not(state(2)) and not(state(1)) and not(state(0)) and x ) or ( not(state(2)) and not(state(1)) and state(0) and not(x) ) or ( state(2) and not(state(1)) and not(state(0)) and x );
temp(0) <= ( not(state(2)) and not(state(1)) and not(state(0)) and not(x) ) or ( not(state(2)) and not(state(1)) and state(0) and not(x) ) or ( not(state(2)) and state(1) and state(0) and not(x) ) or ( not(state(2)) and state(1) and state(0) and x ) or ( state(2) and not(state(1)) and not(state(0)) and not(x) );

process(clk)
begin
if rising_edge(clk) then
s <= ( not(state(2)) and not(state(1)) and not(state(0)) and not(x) ) or ( not(state(2)) and not(state(1)) and state(0) and not(x) ) or ( not(state(2)) and state(1) and not(state(0)) and x ) or ( not(state(2)) and state(1) and state(0) and x ) or ( state(2) and not(state(1)) and not(state(0)) and not(x) ) or ( state(2) and not(state(1)) and state(0) and x ) or ( state(2) and state(1) and not(state(0)) and not(x) );
v <= state(2) and state(1) and not(state(0)) and x;
start <= not start;
end if;
end process;

process(start)
begin
state <= temp;
end process;

end dflo;
